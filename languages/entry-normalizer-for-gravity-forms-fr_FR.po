#: entry-normalizer-for-gravity-forms.php:40
msgid "Entry Normalizer for Gravity Forms requires the Gravity Forms plugin to be active."
msgstr "Entry Normalizer for Gravity Forms nécessite le plugin Gravity Forms pour fonctionner."

#: includes/class-gfen-transforms.php:20
msgid "Remove leading/trailing spaces"
msgstr "Supprimer les espaces en début/fin"

#: includes/class-gfen-transforms.php:21
msgid "Collapse multiple spaces into one"
msgstr "Réduire les espaces multiples à un seul"

#: includes/class-gfen-transforms.php:22
msgid "Remove all spaces"
msgstr "Supprimer tous les espaces"

#: includes/class-gfen-transforms.php:23
msgid "ALL UPPERCASE"
msgstr "Tout en MAJUSCULES"

#: includes/class-gfen-transforms.php:24
msgid "all lowercase"
msgstr "tout en minuscules"

#: includes/class-gfen-transforms.php:25
msgid "Capitalize the first letter only, rest lowercase"
msgstr "Première lettre en majuscule, le reste en minuscules"

#: includes/class-gfen-transforms.php:26
msgid "Capitalize Each Word (Jean-Pierre Dupont)"
msgstr "Majuscule au début de chaque mot (Jean-Pierre Dupont)"

#: includes/class-gfen-transforms.php:27
msgid "Remove accents"
msgstr "Supprimer les accents"

#: includes/class-gfen-transforms.php:28
msgid "Keep letters only"
msgstr "Garder uniquement les lettres"

#: includes/class-gfen-transforms.php:29
msgid "Keep letters and digits only"
msgstr "Garder uniquement lettres et chiffres"

#: includes/class-gfen-transforms.php:29
msgid "Keep digits only"
msgstr "Garder uniquement les chiffres"

#: includes/class-gfen-transforms.php:30
msgid "Remove digits"
msgstr "Supprimer les chiffres"

#: includes/class-gfen-transforms.php:32
msgid "Remove double quotes"
msgstr "Supprimer les guillemets"

#: includes/class-gfen-transforms.php:33
msgid "Strip HTML tags and code"
msgstr "Supprimer les balises HTML et le code"

#: includes/class-gfen-transforms.php:34
msgid "Remove links (URLs)"
msgstr "Supprimer les liens (URL)"

#: includes/class-gfen-transforms.php:30
msgid "French phone number to international format (+33612345678)"
msgstr "Téléphone français au format international (+33612345678)"

#: includes/class-gfen-transforms.php:43
msgid "Removes spaces at the start and end."
msgstr "Supprime les espaces au début et à la fin."

#: includes/class-gfen-transforms.php:44
msgid "Reduces runs of spaces to a single space."
msgstr "Réduit les suites d’espaces à un seul espace."

#: includes/class-gfen-transforms.php:45
msgid "Removes every space."
msgstr "Supprime tous les espaces."

#: includes/class-gfen-transforms.php:46
msgid "Converts the whole value to capital letters."
msgstr "Convertit toute la valeur en majuscules."

#: includes/class-gfen-transforms.php:47
msgid "Converts the whole value to lowercase."
msgstr "Convertit toute la valeur en minuscules."

#: includes/class-gfen-transforms.php:48
msgid "Capitalizes the first letter, lowercases the rest."
msgstr "Met une majuscule à la première lettre et le reste en minuscules."

#: includes/class-gfen-transforms.php:49
msgid "Uppercases the first letter of every word."
msgstr "Met une majuscule à la première lettre de chaque mot."

#: includes/class-gfen-transforms.php:50
msgid "Replaces accented letters with plain ones."
msgstr "Remplace les lettres accentuées par des lettres simples."

#: includes/class-gfen-transforms.php:56
msgid "Keeps only letters (removes digits, spaces and punctuation)."
msgstr "Ne conserve que les lettres (supprime chiffres, espaces et ponctuation)."

#: includes/class-gfen-transforms.php:51
msgid "Keeps only letters and digits."
msgstr "Ne conserve que les lettres et les chiffres."

#: includes/class-gfen-transforms.php:52
msgid "Keeps only digits."
msgstr "Ne conserve que les chiffres."

#: includes/class-gfen-transforms.php:53
msgid "Removes every digit."
msgstr "Supprime tous les chiffres."

#: includes/class-gfen-transforms.php:54
msgid "Removes straight, curly and « » double quotes (keeps apostrophes)."
msgstr "Supprime les guillemets droits, courbes et « » (conserve les apostrophes)."

#: includes/class-gfen-transforms.php:61
msgid "Removes HTML tags, PHP code and script/style contents."
msgstr "Supprime les balises HTML, le code PHP et le contenu des scripts/styles."

#: includes/class-gfen-transforms.php:62
msgid "Removes URLs starting with http(s):// or www."
msgstr "Supprime les URL commençant par http(s):// ou www."

#: includes/class-gfen-transforms.php:53
msgid "Formats French phone numbers as +33XXXXXXXXX."
msgstr "Met les numéros français au format +33XXXXXXXXX."

#: includes/class-gfen-transforms.php:230 includes/class-gfen-addon.php:219
msgid ", then "
msgstr ", puis "

#: includes/class-gfen-addon.php:50
msgid "Normalization"
msgstr "Normalisation"

#: includes/class-gfen-addon.php:130
msgid "Field Normalization"
msgstr "Normalisation des champs"

#: includes/class-gfen-addon.php:132
msgid "Pick a field, provide one or more BEFORE / AFTER examples, and the plugin detects the matching transformation. Preview and apply the fix to existing entries, then enable the rule for future submissions."
msgstr "Choisissez un champ, fournissez un ou plusieurs exemples AVANT / APRÈS, et le plugin détecte la transformation correspondante. Prévisualisez puis appliquez la correction aux entrées existantes, puis activez la règle pour les futures soumissions."

#: includes/class-gfen-addon.php:138
msgid "Normalization rules"
msgstr "Règles de normalisation"

#: includes/class-gfen-addon.php:142 includes/class-gfen-addon.php:228
msgid "%s rule"
msgstr "%s règle"

#: includes/class-gfen-addon.php:143 includes/class-gfen-addon.php:230
msgid "%s rules"
msgstr "%s règles"

#: includes/class-gfen-addon.php:153
msgid "Rules run in the order they appear."
msgstr "Les règles s’appliquent dans l’ordre où elles apparaissent."

#: includes/class-gfen-addon.php:168
msgid "No rules yet. Click “Add a modification” to get started."
msgstr "Aucune règle pour le moment. Cliquez sur « Ajouter une modification » pour commencer."

#: includes/class-gfen-addon.php:169
msgid "Future submissions"
msgstr "Futures soumissions"

#: includes/class-gfen-addon.php:171
msgid "%s example(s)"
msgstr "%s exemple(s)"

#: includes/class-gfen-addon.php:172
msgid "Preview"
msgstr "Aperçu"

#: includes/class-gfen-addon.php:173
msgid "Apply to existing entries"
msgstr "Appliquer aux entrées existantes"

#: includes/class-gfen-addon.php:174
msgid "Edit"
msgstr "Modifier"

#: includes/class-gfen-addon.php:175
msgid "Delete"
msgstr "Supprimer"

#: includes/class-gfen-addon.php:176
msgid "Edit rule"
msgstr "Modifier la règle"

#: includes/class-gfen-addon.php:177
msgid "New modification"
msgstr "Nouvelle modification"

#: includes/class-gfen-addon.php:178
msgid "Field to normalize:"
msgstr "Champ à normaliser :"

#: includes/class-gfen-addon.php:179
msgid "BEFORE / AFTER examples — the more you provide, the more accurate the detection:"
msgstr "Exemples AVANT / APRÈS — plus vous en donnez, plus la détection est précise :"

#: includes/class-gfen-addon.php:180
msgid "BEFORE (e.g. roger)"
msgstr "AVANT (ex. : roger)"

#: includes/class-gfen-addon.php:181
msgid "AFTER (e.g. ROGER)"
msgstr "APRÈS (ex. : ROGER)"

#: includes/class-gfen-addon.php:182
msgid "Remove this example"
msgstr "Supprimer cet exemple"

#: includes/class-gfen-addon.php:183
msgid "Add an example"
msgstr "Ajouter un exemple"

#: includes/class-gfen-addon.php:184
msgid "Detect transformation"
msgstr "Détecter la transformation"

#: includes/class-gfen-addon.php:185
msgid "Detecting…"
msgstr "Détection…"

#: includes/class-gfen-addon.php:186
msgid "Detected transformation(s) — choose the one to apply:"
msgstr "Transformation(s) détectée(s) — choisissez celle à appliquer :"

#: includes/class-gfen-addon.php:187
msgid "No known transformation reproduces all your examples. Check the pairs (typos, spaces) or simplify them."
msgstr "Aucune transformation connue ne reproduit tous vos exemples. Vérifiez les paires (fautes de frappe, espaces) ou simplifiez-les."

#: includes/class-gfen-addon.php:188
msgid "Error during detection."
msgstr "Erreur lors de la détection."

#: includes/class-gfen-addon.php:189
msgid "Network error. Please try again."
msgstr "Erreur réseau. Veuillez réessayer."

#: includes/class-gfen-addon.php:190
msgid "Also apply automatically to future submissions"
msgstr "Appliquer aussi automatiquement aux futures soumissions"

#: includes/class-gfen-addon.php:191
msgid "Save rule"
msgstr "Enregistrer la règle"

#: includes/class-gfen-addon.php:192
msgid "Cancel"
msgstr "Annuler"

#: includes/class-gfen-addon.php:193
msgid "Provide at least one example (the BEFORE column must not be empty)."
msgstr "Renseignez au moins un exemple (la colonne AVANT ne doit pas être vide)."

#: includes/class-gfen-addon.php:194
msgid "Run the detection and choose a transformation."
msgstr "Lancez la détection et choisissez une transformation."

#: includes/class-gfen-addon.php:195 includes/class-gfen-addon.php:482
msgid "Save failed."
msgstr "Échec de l’enregistrement."

#: includes/class-gfen-addon.php:197
msgid "Applying: %1$s / %2$s entries…"
msgstr "Application : %1$s / %2$s entrées…"

#: includes/class-gfen-addon.php:199
msgid "Analyzing: %1$s / %2$s entries…"
msgstr "Analyse : %1$s / %2$s entrées…"

#: includes/class-gfen-addon.php:201
msgid "%1$s entry(ies) modified out of %2$s analyzed."
msgstr "%1$s entrée(s) modifiée(s) sur %2$s analysée(s)."

#: includes/class-gfen-addon.php:203
msgid "%s write error(s)."
msgstr "%s erreur(s) d’écriture."

#: includes/class-gfen-addon.php:205
msgid "%1$s entry(ies) would be modified out of %2$s analyzed. Nothing has been written."
msgstr "%1$s entrée(s) seraient modifiée(s) sur %2$s analysée(s). Aucune écriture n’a été faite."

#: includes/class-gfen-addon.php:207
msgid "%s value(s) not recognized as a French phone number — left unchanged:"
msgstr "%s valeur(s) non reconnue(s) comme téléphone français — laissée(s) telle(s) quelle(s) :"

#: includes/class-gfen-addon.php:208
msgid "Entry"
msgstr "Entrée"

#: includes/class-gfen-addon.php:209
msgid "Before"
msgstr "Avant"

#: includes/class-gfen-addon.php:210
msgid "After (applied)"
msgstr "Après (appliqué)"

#: includes/class-gfen-addon.php:211
msgid "After (proposed)"
msgstr "Après (proposé)"

#: includes/class-gfen-addon.php:213
msgid "… and %s more change(s) not shown."
msgstr "… et %s autre(s) modification(s) non affichée(s)."

#: includes/class-gfen-addon.php:214
msgid "This form has no compatible text field."
msgstr "Ce formulaire ne contient aucun champ texte compatible."

#: includes/class-gfen-addon.php:215
msgid ""
"Permanently apply this transformation to the existing entries?\n"
"\n"
"Tip: run a preview first. This action modifies stored data."
msgstr ""
"Appliquer définitivement cette transformation aux entrées existantes ?\n"
"\n"
"Conseil : lancez d’abord un aperçu. Cette action modifie les données enregistrées."

#: includes/class-gfen-addon.php:216
msgid "Delete this rule? (Entries already modified will not be restored.)"
msgstr "Supprimer cette règle ? (Les entrées déjà modifiées ne seront pas restaurées.)"

#: includes/class-gfen-addon.php:217
msgid "Error during processing."
msgstr "Erreur pendant le traitement."

#: includes/class-gfen-addon.php:221
msgid "Deleted field (%s)"
msgstr "Champ supprimé (%s)"

#: includes/class-gfen-addon.php:224
msgid "Add a modification"
msgstr "Ajouter une modification"

#: includes/class-gfen-addon.php:225
msgid "No normalization rules yet"
msgstr "Aucune règle de normalisation pour le moment"

#: includes/class-gfen-addon.php:226
msgid "Create your first rule to automatically clean up field values — like forcing uppercase, trimming spaces, or fixing formats."
msgstr "Créez votre première règle pour nettoyer automatiquement les valeurs des champs — mise en majuscules, suppression des espaces ou correction de formats."

#: includes/class-gfen-addon.php:231
msgid "Not saved"
msgstr "Non enregistré"

#: includes/class-gfen-addon.php:232
msgid "Field to normalize"
msgstr "Champ à normaliser"

#: includes/class-gfen-addon.php:233
msgid "BEFORE / AFTER examples"
msgstr "Exemples AVANT / APRÈS"

#: includes/class-gfen-addon.php:234
msgid "The more you provide, the more accurate the detection."
msgstr "Plus vous en fournissez, plus la détection est précise."

#: includes/class-gfen-addon.php:235
msgid "BEFORE"
msgstr "AVANT"

#: includes/class-gfen-addon.php:236
msgid "AFTER"
msgstr "APRÈS"

#: includes/class-gfen-addon.php:237
msgid "e.g. roger"
msgstr "ex. : roger"

#: includes/class-gfen-addon.php:238
msgid "e.g. ROGER"
msgstr "ex. : ROGER"

#: includes/class-gfen-addon.php:239
msgid "Detect the transformation"
msgstr "Détecter la transformation"

#: includes/class-gfen-addon.php:240
msgid "Exact match"
msgstr "Correspondance exacte"

#: includes/class-gfen-addon.php:241
msgid "New entries will be normalized as they come in."
msgstr "Les nouvelles entrées seront normalisées au fur et à mesure."

#: includes/class-gfen-addon.php:242
msgid "This won't touch existing entries until you preview & apply."
msgstr "Cela ne modifiera pas les entrées existantes tant que vous n’aurez pas prévisualisé et appliqué."

#: includes/class-gfen-addon.php:306
msgid "Warning: this field already has “GF Auto Formatter” formatting configured (in the field’s Advanced tab). On new submissions, both formattings will run in sequence and may contradict each other. The bulk apply, however, always matches the preview."
msgstr "Attention : ce champ a déjà un formatage « GF Auto Formatter » configuré (onglet Avancé du champ). Sur les nouvelles soumissions, les deux formatages s’enchaîneront et peuvent se contredire. L’application en masse, elle, reste fidèle à l’aperçu."

#: includes/class-gfen-addon.php:354
msgid "Insufficient permissions."
msgstr "Permissions insuffisantes."

#: includes/class-gfen-addon.php:359
msgid "Form not found."
msgstr "Formulaire introuvable."

#: includes/class-gfen-addon.php:395
msgid "Provide at least one BEFORE/AFTER example."
msgstr "Fournissez au moins un exemple AVANT/APRÈS."

#: includes/class-gfen-addon.php:405
msgid "All your examples are identical before and after: there is no transformation to detect."
msgstr "Tous vos exemples sont identiques avant et après : aucune transformation à détecter."

#: includes/class-gfen-addon.php:427
msgid "Invalid rule."
msgstr "Règle invalide."

#: includes/class-gfen-addon.php:432
msgid "Invalid target field."
msgstr "Champ cible invalide."

#: includes/class-gfen-addon.php:444
msgid "No transformation selected."
msgstr "Aucune transformation sélectionnée."

#: includes/class-gfen-addon.php:501
msgid "Delete failed."
msgstr "Échec de la suppression."

#: includes/class-gfen-addon.php:522
msgid "Rule not found."
msgstr "Règle introuvable."

